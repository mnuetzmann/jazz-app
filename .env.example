# Copy this file to .env and fill in the values. Never commit .env.
ELEVENLABS_API_KEY=
# One or more announcer voices as Name:voice_id, comma separated (first is the default).
# Find ids with: python3 tts.py voices
ELEVENLABS_VOICES=Midnight Jazz Host:KNujgOxpr0Y4KhrYpOe1, New Orleans Jazz Crooner:wDsL4jrWvw6jY8gyV5Fi
# Old single-voice setting, used only if ELEVENLABS_VOICES is empty
ELEVENLABS_VOICE_ID=KNujgOxpr0Y4KhrYpOe1
# Find valid values with: python3 tts.py models
ELEVENLABS_MODEL_ID=eleven_v4
# Stops runaway cost: speech characters allowed per day
TTS_DAILY_CHAR_LIMIT=20000
TTS_MONTHLY_CHAR_LIMIT=100000
